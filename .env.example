# Autonomous Multi-Agent Habitat (AMH) Environment Configuration

# === Durable Execution (DBOS Transact) + Core Persistence ===
# PostgreSQL is authoritative persistent state from day one (§1 decision 4)
# — not a "V1 default, migrate to Postgres later" path. DBOS's own system
# tables and every AMH-owned table (daemon/store, store/migrations) live in
# this same database. Both amh-daemon (via daemon/store, github.com/jackc/pgx)
# and the Python agent layer (via psycopg, the dbos package's own driver)
# connect to it directly.
DATABASE_URL=postgresql://amh:amh@localhost:5432/amh

# === Go Daemon ===
# Supervisor, scheduler, MCP gateway, device I/O
AMH_DAEMON_PORT=8080
AMH_DAEMON_HOST=127.0.0.1

# Daemon-internal actuation API — the Python agent layer's bridge into the
# daemon's connector registry (daemon/api, daemon/connectors). Not a
# client-facing edge; see FIELD_HTTP_PORT/ARCHITECT_HTTP_PORT below for those.
AMH_API_PORT=8090

# MCP server (daemon/mcp) — exposes a fixed catalog of AMH capabilities
# (actuate_device, request_approval, check_approval) to external MCP
# clients over Streamable HTTP, gated by the same AMH_API_AGENT_TOKEN/
# AMH_API_OPERATOR_TOKEN bearer tokens as every other daemon route.
AMH_MCP_PORT=8093

# Required — the daemon refuses to start the API server without both.
# Two DISTINCT bearer tokens, one per role (daemon/authn):
#   AMH_API_AGENT_TOKEN     — the Python agent layer: actuate, create/check
#                             approval tickets. Cannot approve a ticket.
#   AMH_API_OPERATOR_TOKEN  — the only credential that can approve an
#                             ApprovalGate ticket (§12, §14.7). Never give
#                             this to the agent process/environment — the
#                             whole security property is that the agent
#                             does not hold it.
# Generate with: openssl rand -hex 32
AMH_API_AGENT_TOKEN=
AMH_API_OPERATOR_TOKEN=

# Systemd service name (Linux)
AMH_SYSTEMD_SERVICE=amh-daemon

# === Control plane: extension registry, computers, credentials ===
# Where per-agent computer (sandbox) workdirs are created (daemon/sandbox).
AMH_SANDBOX_DIR=./state/computers

# Encrypts the account/module credential store at rest (daemon/credentials,
# AES-256-GCM). Optional — if unset, the daemon still starts, but the
# /v1/accounts and /v1/accounts/*/credential routes return 503 rather than
# silently storing anything unencrypted. Generate with: openssl rand -base64 32
AMH_CREDENTIAL_KEY=

# Set automatically by amh-daemon (from AMH_DAEMON_HOST/AMH_API_PORT) and
# inherited by every process-isolation extension it launches (daemon/
# extensions) — this is how an extension like the control-plane UI
# (extensions/control-plane-ui) finds its way back to the admin API without
# being told separately. Only set this yourself to override that default.
# AMH_API_BASE_URL=http://127.0.0.1:8090

# === HTTP API Edges ===
FIELD_HTTP_PORT=8081
ARCHITECT_HTTP_PORT=8082

# === Scheduler ===
# The one kernel-owned ticker that fires routines, deadlines, and nextWake.
HABITAT_ROUTINE_TICK_MS=60000

# === Per-tenant State ===
# Where per-tenant on-disk state (packs, runs, wake-log, etc.) is written.
HABITAT_STATE_DIR=./state

# === Trust Anchors ===
# Ed25519 public keys the pack loader verifies signatures against.
# No key is ever generated at boot; supply public keys here.
HABITAT_TRUST_ANCHORS=./fixtures/keys

# === Model / LLM Adapter ===
# agents/context/llm.py is a pure HTTP client to the daemon's inference
# seam (daemon/inference) — it holds no model-provider credential itself.
# decompose_goal, do_subagent_work, and llm_summarize all call through it
# and raise ModelNotConfiguredError (not a fake result) if the daemon has
# no matching provider account registered.
#
# ADAPTER_MODEL selects which model to ask for (required); ADAPTER_PROVIDER
# selects which registered daemon/credentials account to use (optional,
# defaults to "anthropic"). The actual API key/OAuth token/base_url live
# once, centrally, registered by an operator through the control-plane
# UI's Accounts tab (or POST /v1/accounts + /v1/accounts/{id}/credential)
# — never in this process's own environment.
#
# ADAPTER_PROVIDERS, if set, is a comma-separated ordered failover chain
# (daemon/inference's Request.Providers) — e.g. "grok,anthropic" tries
# grok first and falls over to anthropic on any failure. Takes precedence
# over ADAPTER_PROVIDER when set.
ADAPTER_MODEL=claude-sonnet-4-6
ADAPTER_PROVIDER=anthropic

# ADAPTER_EMBEDDING_MODEL/_PROVIDER/_PROVIDERS configure agents/memory's
# embedding calls (ModelClient.embed(), daemon/inference's Router.Embed) the
# same way as ADAPTER_MODEL/_PROVIDER/_PROVIDERS above, but separately —
# embeddings are only implemented for the openai_compatible provider kind
# (Anthropic has no first-party embeddings API), so a habitat using
# ADAPTER_PROVIDER=anthropic for completions needs a distinct registered
# account here, e.g. an OpenAI or Voyage AI account.
ADAPTER_EMBEDDING_MODEL=text-embedding-3-small
ADAPTER_EMBEDDING_PROVIDER=openai

# === Subagent Concurrency (agents/workflows/goal.py) ===
# Bounds how many subagents pursue_goal runs at once via a durable DBOS
# Queue — a goal that decomposes into more tasks than this queues the rest
# rather than firing every model call and SQLite write at once. Read once
# at process start (a DBOS Queue's concurrency is fixed at construction).
AMH_SUBAGENT_CONCURRENCY=5

# === Agent Layer (Python) ===
# UV package manager and DBOS worker process management
PYTHON_VERSION=3.12
UV_PYTHON=3.12

# Budget for a single agent run
CONTEXT_WINDOW_TOKENS=180000
CONTEXT_COMPACT_AT=0.70
TOOL_RESULT_CAP=25000

# === Semantic + Entity Memory (agents/memory/graph.py, Graphiti/Neo4j) ===
# Neo4j is the adopted production graph backend for the semantic
# (bi-temporal claim graph) and entity memory projections (§8) — Graphiti
# (getzep/graphiti) owns the graph directly; agents/memory/graph_llm.py
# bridges Graphiti's LLM/embedder/cross-encoder calls to the daemon's
# inference seam, so Graphiti never holds a model-provider credential.
GRAPHITI_NEO4J_URI=bolt://localhost:7687
GRAPHITI_NEO4J_USER=neo4j
GRAPHITI_NEO4J_PASSWORD=
GRAPHITI_NEO4J_DATABASE=neo4j
# Sandbox/test opt-in only (embedded, no external service) — set only when
# GRAPHITI_NEO4J_URI is unset; see memory/graph.py's docstring for the real,
# upstream-confirmed limitations of using Kuzu instead of Neo4j.
# GRAPHITI_KUZU_DB_PATH=:memory:
# Must match the real output dimensionality of the daemon-routed embedding
# model (see memory/graph_llm.py's DaemonGraphitiEmbedderClient docstring)
# — not guessed.
GRAPHITI_EMBEDDING_DIM=1024

# === Memory Wiring (agents/workflows/memory_hooks.py) ===
# The Hindsight bank / Graphiti group_id episodic+semantic memory is
# partitioned under — one habitat-wide partition by default. Set this to
# separate multiple habitats sharing one Hindsight/Neo4j deployment.
AMH_MEMORY_BANK_ID=amh-habitat

# === Episodic Memory + Knowledge Retrieval (agents/memory/episodic.py, Hindsight) ===
# Hindsight (vectorize-io/hindsight) is self-hosted, schema-isolated within
# the SAME PostgreSQL cluster as the rest of AMH's authoritative state —
# not a second database. Hindsight is a separate service process
# (`pip install hindsight-api-slim`; run via its own `hindsight-api` CLI),
# not a dependency of agents/ itself — agents/ only holds the address of a
# running instance, via hindsight-client (see memory/episodic.py).
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=

# The variables below configure the Hindsight SERVER process itself (its
# own environment, not this one) — included here as the deployment
# reference, matching how Postgres/Neo4j connection details are documented
# without this codebase vendoring their server code.
#   HINDSIGHT_API_DATABASE_URL=postgresql://amh:amh@localhost:5432/amh
#   HINDSIGHT_API_DATABASE_SCHEMA=hindsight
#   HINDSIGHT_API_RERANKER_PROVIDER=rrf   # algorithmic (Reciprocal Rank Fusion) — no model, no local ML weights
#
# Every model call Hindsight makes routes through daemon/api's
# OpenAI-compatible facade (/v1/openai/chat/completions, /v1/openai/embeddings
# — see daemon/api/controlplane.go) rather than a direct provider credential.
# "<amh_provider>/<model>" selects which daemon-registered account to use
# (splitOpenAIModel's convention, matching litellm/OpenRouter); the "api_key"
# Hindsight sends is just the daemon agent bearer token, not a real provider
# secret. Verified for real against a live hindsight-api-slim instance that
# the daemon's OpenAI-compatible facade is sufficient (Hindsight never sends
# an OpenAI "tools"/"tool_choice"/"response_format" field for either
# extraction or embeddings — see memory/episodic.py's module docstring).
#   HINDSIGHT_API_LLM_PROVIDER=openai
#   HINDSIGHT_API_LLM_BASE_URL=http://localhost:8080/v1/openai
#   HINDSIGHT_API_LLM_MODEL=anthropic/claude-sonnet-5
#   HINDSIGHT_API_LLM_API_KEY=<a daemon agent bearer token>
#   HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai
#   HINDSIGHT_API_EMBEDDINGS_OPENAI_BASE_URL=http://localhost:8080/v1/openai
#   HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=<embedding-account>/<embedding-model>
#   HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=<a daemon agent bearer token>
#   HINDSIGHT_API_EMBEDDINGS_OPENAI_DIMENSIONS=1024

# === Observability ===
# OpenTelemetry GenAI semantic conventions
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=amh
OTEL_TRACES_EXPORTER=otlp

# === Logging ===
LOG_LEVEL=info

# === Testing / Local Development ===
# Uncomment to use in-memory SQLite (dev only, not production)
# DATABASE_URL=sqlite::memory:

# Uncomment to use Temporal dev-server instead of DBOS (for comparison)
# DURABLE_ENGINE=temporal
# TEMPORAL_SERVER=localhost:7233
