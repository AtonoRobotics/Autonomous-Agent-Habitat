# habitat.config
# Every numeric threshold and default the specs reference. Configuration, not design.
# Loaded at first boot into ontd as habitat/Config; edits are os/Edit + os/Rebuild on the host.

[headcount]
max_agents              = 8
max_humans              = 4
budget_total_units      = 20000000        # per day, across all residents; backend-priced units (registryd Decision 2)
budget_per_agent_min    = 500000          # config load fails if min * max_agents > total
budget_gpu_seconds_total = 86400

[budget]
threshold_warn          = 0.75            # on-budget-threshold hook fires
threshold_scope         = 0.90            # hook may narrow scope

[agents]
subuid_range_size       = 65536
subagent_max_depth      = 3
subagent_default_ttl    = 90m             # sized for multi-minute turns; charters may set per wake class
private_memory_cap_facts = 4096
private_memory_trust_floor = 0.2
drain_timeout           = 24h             # open yields reassigned to successor after this
creating_timeout        = 10m             # CreatingStale rollback
idle_resident_days      = 14
charter_breadth_max_types = 12

[cortexd]
compression_soft        = 0.50            # of backend window
compression_soft_tokens = 200000          # absolute; whichever is reached first
compression_hard        = 0.85
wake_idle_timeout       = 20m             # no streamed event for this long
context_max_tokens      = 60000
approximate_recall      = false
parse_retry             = 1
refusal_reroute_max     = 2
effort_default          = high
effort_subagent         = low
effort_authoring        = xhigh
effort_on_threshold_scope = medium
eval_min_pass           = 0.95

[wfd]
max_parallel_per_owner  = 8
step_timeout_default    = 5m              # host steps only; machine jobs use machine_default_ttl
inotify_coalesce        = 1s
machine_boot_timeout    = 5s
machine_default_ttl     = 90m
action_confirmation_window = 5m

[ontd]
snapshot_interval       = 15m
snapshot_retain_short   = 48h
snapshot_retain_daily   = 30d
near_duplicate_threshold = 0.85           # structural similarity; start strict
yield_recurrence_min    = 5               # resolutions in window
yield_recurrence_window = 30d
yield_recurrence_entropy = 0.5
sensor_precision_low    = 0.30
sensor_precision_min_usage = 20
type_orphan_grace       = 14d
yield_stale             = 72h
gap_aging               = 48h
migration_regret_window = 14d
migration_regret_factor = 1.5
cosign_expiry           = 7d

[headcount_sensors]
threshold_quarter       = 0.25
threshold_tenth         = 0.10
rate_max_per_24h        = 3

[host]
clock_skew_degrade      = 1s
journal_max_per_resident = 2G
dataset_usage_high      = 0.85
cgroup_memory_high      = 0.90
