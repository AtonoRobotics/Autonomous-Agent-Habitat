{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amh.dev/schemas/v1/action-envelope.schema.json",
  "title": "AMH Action Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operationId", "principalId", "extensionId", "extensionVersion",
    "actionType", "actionSchemaVersion", "payload", "payloadDigest", "properties",
    "retryClass", "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "operationId": { "$ref": "#/$defs/uuid" },
    "principalId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "extensionId": { "$ref": "#/$defs/namespacedId" },
    "extensionVersion": { "$ref": "#/$defs/semver" },
    "actionType": { "$ref": "#/$defs/namespacedId" },
    "actionSchemaVersion": { "$ref": "#/$defs/semver" },
    "payload": {},
    "payloadDigest": { "$ref": "#/$defs/sha256" },
    "properties": {
      "type": "object",
      "additionalProperties": true,
      "required": ["reversibility"],
      "properties": {
        "reversibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["verified", "claimed", "none"] },
            "attestationRef": { "type": "string", "format": "uri-reference" },
            "inverseContractRef": { "type": "string", "format": "uri-reference" }
          },
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "verified" } } },
              "then": { "required": ["attestationRef", "inverseContractRef"] }
            }
          ]
        }
      }
    },
    "domainContextRef": { "type": "string", "format": "uri-reference" },
    "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
    "retryClass": { "enum": ["never", "reconcile_before_retry", "idempotent"] },
    "deadline": { "type": "string", "format": "date-time" },
    "createdAt": { "type": "string", "format": "date-time" },
    "traceId": { "type": "string", "pattern": "^[a-f0-9]{32}$" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "namespacedId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$", "maxLength": 192 },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
