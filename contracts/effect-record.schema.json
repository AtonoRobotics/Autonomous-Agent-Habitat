{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amh.dev/schemas/v1/effect-record.schema.json",
  "title": "AMH Effect Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "effectId", "operationId", "ownerExtensionId", "effectType",
    "state", "forwardDigest", "sequence", "createdAt", "updatedAt", "rowVersion"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "effectId": { "type": "string", "format": "uuid" },
    "operationId": { "type": "string", "format": "uuid" },
    "ownerExtensionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$" },
    "effectType": { "type": "string", "minLength": 1, "maxLength": 192 },
    "state": {
      "enum": [
        "proposed", "admitted", "rejected", "needs_approval", "dispatch_pending",
        "dispatched", "observed", "outcome_unknown", "confirmed", "reconciled",
        "compensated", "failed"
      ]
    },
    "forwardDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "inverseRef": { "type": "string", "format": "uri-reference" },
    "reconciliationRef": { "type": "string", "format": "uri-reference" },
    "externalCommandId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "attempt": { "type": "integer", "minimum": 0 },
    "sequence": { "type": "integer", "minimum": 0 },
    "observationRef": { "type": "string", "format": "uri-reference" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retryable", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
        "retryable": { "type": "boolean" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "detailsRef": { "type": "string", "format": "uri-reference" }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "rowVersion": { "type": "integer", "minimum": 0 }
  }
}
