# Business truth. Missing or unreachable fails closed — there is no in-process ledger.
DATABASE_URL=postgres://habitat:habitat@127.0.0.1:5432/habitat

# HTTP edges
FIELD_HTTP_PORT=8080
ARCHITECT_HTTP_PORT=8081

# The one kernel-owned ticker that fires routines, deadlines, and nextWake.
HABITAT_ROUTINE_TICK_MS=60000

# Where per-tenant state is written.
HABITAT_STATE_DIR=./state

# Trust anchors the pack loader verifies signatures against. No key is ever
# generated at boot; supply public keys here.
HABITAT_TRUST_ANCHORS=./fixtures/keys

# The model is bound per tenant by the Architect at runtime, not here.
# There is no silent default adapter.
