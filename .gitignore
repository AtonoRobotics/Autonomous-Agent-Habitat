# Environment and secrets
.env
.env.*
!.env.example

# Per-tenant on-disk state — never committed
state/*
!state/.gitkeep

# Real signing keys never enter the repo; fixtures/keys holds throwaways only
*.pem
*.key
!fixtures/keys/*.pub

# IDE and editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
*.log

# SQLite databases (for local testing only; prod data stored elsewhere)
*.db
*.db-shm
*.db-wal
